# ─────────────────────────────────────────────────────────
# SeaFin environment variables
# Copy this file to ".env" and fill in your keys. All optional:
# the app runs without them (offline engines + cached/fallback rates,
# local-only backups). Keys unlock the live/cloud upgrades.
# ─────────────────────────────────────────────────────────

# ExchangeRate-API (FREE — live USD/BDT rate)
# Get a key: https://app.exchangerate-api.com/sign-up
VITE_EXCHANGERATE_API_KEY=028fc9b98530c3975f572ba5

# Google Gemini 1.5 Flash (FREE — Nawab AI + receipt/statement OCR)
# Get a key: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Groq Llama 3.3 70B (FREE — backup AI)
# Get a key: https://console.groq.com
VITE_GROQ_API_KEY=

# Google Drive backup sync (OAuth client ID)
# 1. https://console.cloud.google.com → new project
# 2. APIs & Services → Enable "Google Drive API"
# 3. Credentials → Create OAuth client ID → Web application
# 4. Add your dev origin (e.g. http://localhost:5173) to Authorized JavaScript origins
# 5. Paste the client ID (ends with .apps.googleusercontent.com) below
VITE_GOOGLE_CLIENT_ID=
